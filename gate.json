      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "dev-lint",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "run",
        "git+file:../dev-lint?ref=HEAD#gate",
        "--",
        "--check-table",
        "gate.dhall",
        "gate.json"
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "the table matches its Dhall",
      "timeout_s": 300
    }
  ],
  "name": "nixos-config"
}
