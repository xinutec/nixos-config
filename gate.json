{
  "checks": [
    {
      "argv": [
        "nix",
        "develop",
        "path:./nix",
        "--no-warn-dirty",
        "--command",
        "python3",
        "scripts/eval_machines.py"
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "nix eval — every machine's full NixOS config",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "path:./nix",
        "--no-warn-dirty",
        "--command",
        "nix-instantiate",
        "--eval",
        "--strict",
        "-E",
        "let p = import <nixpkgs> {}; m = import ./machines/isis/frontdoor.nix { config = {}; lib = p.lib; pkgs = p; }; in builtins.length (builtins.attrNames m.services.nginx.virtualHosts)"
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "isis front door evaluates, and no VpnOnly name listens publicly",
      "timeout_s": 600
    },
    {
      "argv": [
        "nix",
        "develop",
        "path:./nix",
        "--no-warn-dirty",
        "--command",
        "ruff",
        "check",
        "."
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "ruff (operational Python)",
      "timeout_s": 300
    },
    {
      "argv": [
        "nix",
        "develop",
        "path:./nix",
        "--no-warn-dirty",
        "--command",
        "mypy",
        "--strict",
        "machines/amun/vpn-nodes-push.py",
        "machines/odin/backup_preview.py",
        "plan-fleetwatch-push.py"
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "mypy --strict (operational Python)",
      "timeout_s": 600
    },
    {
      "argv": [
        "nix",
        "develop",
        "path:./nix",
        "--no-warn-dirty",
        "--command",
        "python",
        "-m",
        "pytest",
        "-q",
        "machines",
        "test_plan_fleetwatch_push.py"
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "pytest (operational Python)",
      "timeout_s": 600
    },
    {
      "argv": [
        "nix",
        "develop",
        "path:./nix",
        "--no-warn-dirty",
        "--command",
        "find",
        "machines",
        "scripts",
        "setup.sh",
        "-name",
        "*.sh",
        "-exec",
        "shellcheck",
        "{}",
        "+"
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "shellcheck (host-side shell scripts)",
      "timeout_s": 300
    },
    {
      "argv": [
        "nix",
        "run",
        "git+file:../dev-lint?ref=HEAD",
        "--",
