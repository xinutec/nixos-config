#!/usr/bin/env bash
# Single health gate. A commit must be healthy: this runs the full gate
# (gate.json, rendered from gate.dhall) — every machine's NixOS config is
# evaluated, plus ruff, mypy --strict, pytest, shellcheck, the reconciler's
# cross-checks against backup-prepare.sh, and the shared dev-lint rules.
# Slow by design; we optimise for healthy commits, not commit speed.
# Quiet on success: the gate prints a check's output only when it FAILS, so a
# healthy commit isn't buried under eval noise (DL-GIT-PRECOMMIT-GATE).
# Bypass a genuine work-in-progress commit with:  git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! out=$(nix run "git+file:../dev-lint?ref=HEAD#gate" -- . gate.json 2>&1); then
  printf '%s\n' "$out" >&2
  exit 1
fi
